+import XCTest
+
+/// SPIKE (westron, 2026-11-24): the Move to… picker drawn with westron's components, put up over the Lists screen and
+/// kept as a screenshot in the result bundle for a person to look at. It asserts only that the sheet came up with its
+/// hint, "Top level" and the area's line, and that Cancel takes it down.
+final class PickerWalks: Walk {
+    /// The system's process under the app, through which a hold is aimed (`MenuWalks`).
+    private let springboard = XCUIApplication(bundleIdentifier: "com.apple.springboard")
+
+    func testMovePickerOnWestron() {
+        // An area, through "+", New Area, so that the picker has a labelled line to draw too.
+        app.buttons["Add"].firstMatch.tap()
+        let newArea = app.buttons["New Area"].firstMatch
+        XCTAssertTrue(newArea.waitForExistence(timeout: 2), "+ offers no New Area")
+        newArea.tap()
+        settle(1)
+        app.typeText("Work\n")
+        settle(1)
+        // Core's menu, by a still hold on its row, and its Move to….
+        let core = app.staticTexts["Core"].firstMatch
+        XCTAssertTrue(core.waitForExistence(timeout: 2), "no Core on the Lists screen")
+        onScreen(core).press(forDuration: 1.2)
+        let move = app.buttons["Move to…"].firstMatch
+        XCTAssertTrue(move.waitForExistence(timeout: 3), "no Move to… after a still hold on Core")
+        move.tap()
+        XCTAssertTrue(app.staticTexts["Choose where it goes."].waitForExistence(timeout: 5), "the picker did not come up")
+        settle(1.5)
+        let shot = XCTAttachment(screenshot: XCUIScreen.main.screenshot())
+        shot.name = "move-picker"
+        shot.lifetime = .keepAlways
+        add(shot)
+        XCTAssertTrue(
+            app.descendants(matching: .any).matching(NSPredicate(format: "label BEGINSWITH %@", "Top level"))
+                .firstMatch.exists,
+            "the picker has no Top level"
+        )
+        app.navigationBars.buttons["Cancel"].firstMatch.tap()
+        XCTAssertTrue(
+            app.staticTexts["Choose where it goes."].waitForNonExistence(timeout: 3), "Cancel left the picker up"
+        )
+    }
+
+    /// The centre of an element, as a point of the screen reached through the springboard (`MenuWalks.onScreen`).
+    private func onScreen(_ element: XCUIElement) -> XCUICoordinate {
+        let frame = element.frame
+        return springboard.coordinate(withNormalizedOffset: .zero).withOffset(CGVector(dx: frame.midX, dy: frame.midY))
+    }
+}
