{
  "shadow": {
    "$type": "shadow",
    "resting": {
      "$value": {
        "color": {"colorSpace": "oklch", "components": [0, 0, "none"], "alpha": 0.06, "hex": "#000000"},
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": {"value": 1, "unit": "px"},
        "blur": {"value": 2, "unit": "px"},
        "spread": {"value": 0, "unit": "px"}
      },
      "$description": "A card at rest on a fill."
    },
    "hovered": {
      "$value": {
        "color": {"colorSpace": "oklch", "components": [0, 0, "none"], "alpha": 0.08, "hex": "#000000"},
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": {"value": 3, "unit": "px"},
        "blur": {"value": 10, "unit": "px"},
        "spread": {"value": 0, "unit": "px"}
      },
      "$description": "A card under the pointer."
    },
    "raised": {
      "$value": {
        "color": {"colorSpace": "oklch", "components": [0, 0, "none"], "alpha": 0.12, "hex": "#000000"},
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": {"value": 5, "unit": "px"},
        "blur": {"value": 24, "unit": "px"},
        "spread": {"value": 0, "unit": "px"}
      },
      "$description": "A control raised off what it stands on: a floating button, an open card."
    },
    "lifted": {
      "$value": {
        "color": {"colorSpace": "oklch", "components": [0, 0, "none"], "alpha": 0.22, "hex": "#000000"},
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": {"value": 10, "unit": "px"},
        "blur": {"value": 36, "unit": "px"},
        "spread": {"value": 0, "unit": "px"}
      },
      "$description": "Something a drag carries."
    }
  }
}
