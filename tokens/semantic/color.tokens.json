{
  "color": {
    "$type": "color",
    "$description": "Semantic colors: what each color is for. They alias the color ramps, which the palette generator solves for each theme, so one file serves the four themes (decisions/0012).",
    "background": {
      "canvas": {
        "$value": "{color.neutral.1}",
        "$description": "The ground of a screen, a list or a table.",
        "$extensions": {
          "dev.westron.usage": {
            "use": ["screen background", "list background"],
            "avoid": "Cards and sheets: use background.surface."
          }
        }
      },
      "surface": {
        "$value": "{color.neutral.raised}",
        "$description": "Something raised off the canvas: a card, a sheet or a popover westron draws, a dragged row. White in light; one step lighter than the canvas in dark, where higher is lighter.",
        "$extensions": {
          "dev.westron.usage": {
            "use": ["card", "sheet", "popover", "dragged row"],
            "avoid": "A well below the content: use background.sunken."
          }
        }
      },
      "sunken": {
        "$value": "{color.neutral.sunken}",
        "$description": "A well below the canvas: a sidebar, a code block, a log, a table header.",
        "$extensions": {
          "dev.westron.usage": {
            "use": ["sidebar", "code block", "log", "table header"],
            "avoid": "A control's fill: use background.muted."
          }
        }
      },
      "muted": {
        "$value": "{color.neutral.4}",
        "$description": "A quiet fill inside content: the track of a segmented control, a tag or a badge without a color.",
        "$extensions": {
          "dev.westron.usage": {
            "use": ["segmented track", "neutral tag", "neutral badge"],
            "avoid": "A row under the pointer: use background.hover."
          }
        }
      },
      "hover": {"$value": "{color.neutral.3}", "$description": "A row or a control under the pointer."},
      "pressed": {"$value": "{color.neutral.5}", "$description": "A row or a control while it is pressed."},
      "selected": {
        "$value": "{color.blue.5}",
        "$description": "A selected row or item, tinted with the accent.",
        "$extensions": {
          "dev.westron.usage": {
            "use": ["selected row", "selected item"],
            "avoid": "Color alone: in high contrast a selected row also shows a check or a border.focus outline."
          }
        }
      },
      "accent-subtle": {
        "$value": "{color.blue.3}",
        "$description": "A quiet accent ground: the tile behind an empty state's icon, a highlighted tip."
      },
      "accent": {
        "$value": "{color.blue.9}",
        "$description": "The fill of the one primary action on a screen, a checked box, a switch that is on.",
        "$extensions": {
          "dev.westron.usage": {
            "use": ["primary button", "checked box", "switch on"],
            "avoid": "Large areas, and more than one filled control on a screen. Status: use status.info.fill, even though info is the accent's blue today."
          }
        }
      },
      "accent-hover": {"$value": "{color.blue.10}", "$description": "The accent fill under the pointer."}
    },
    "text": {
      "primary": {
        "$value": "{color.neutral.12}",
        "$description": "Main text and glyphs.",
        "$extensions": {
          "dev.westron.contrast": [
            {
              "kind": "text",
              "on": [
                "color.background.canvas",
                "color.background.surface",
                "color.background.sunken",
                "color.background.muted",
                "color.background.hover",
                "color.background.pressed",
                "color.background.selected",
                "color.background.accent-subtle"
              ]
            }
          ]
        }
      },
      "secondary": {
        "$value": "{color.neutral.11}",
        "$description": "Text and glyphs that come second: captions, metadata, a row's details, timestamps.",
        "$extensions": {
          "dev.westron.contrast": [
            {
              "kind": "text",
              "on": [
                "color.background.canvas",
                "color.background.surface",
                "color.background.sunken",
                "color.background.muted",
                "color.background.hover",
                "color.background.pressed",
                "color.background.selected",
                "color.background.accent-subtle"
              ]
            }
          ]
        }
      },
      "placeholder": {
        "$value": "{color.neutral.11}",
        "$description": "The placeholder of an empty field. It meets the text target, as all words do.",
        "$extensions": {
          "dev.westron.contrast": [
            {
              "kind": "text",
              "on": [
                "color.background.canvas",
                "color.background.surface",
                "color.background.sunken",
                "color.background.muted"
              ]
            }
          ]
        }
      },
      "on-accent": {
        "$value": "{color.blue.contrast}",
        "$description": "Text and glyphs on the accent fill: white, and the canvas's color in dark high contrast, where the fill turns light.",
        "$extensions": {
          "dev.westron.contrast": [{"kind": "text", "on": ["color.background.accent", "color.background.accent-hover"]}]
        }
      },
      "accent": {
        "$value": "{color.blue.11}",
        "$description": "Links and accent text.",
        "$extensions": {
          "dev.westron.usage": {
            "use": ["link", "accent text"],
            "avoid": "Status text: use status.<name>.text."
          },
          "dev.westron.contrast": [
            {
              "kind": "text",
              "on": [
                "color.background.canvas",
                "color.background.surface",
                "color.background.sunken",
                "color.background.hover",
                "color.background.selected",
                "color.background.accent-subtle"
              ]
            }
          ]
        }
      }
    },
    "icon": {
      "tertiary": {
        "$value": "{color.neutral.8}",
        "$description": "Glyphs that carry no words and need only 3:1: a chevron, a grip, a disclosure triangle.",
        "$extensions": {
          "dev.westron.usage": {
            "use": ["chevron", "grip", "disclosure"],
            "avoid": "Words: words are text.secondary at least."
          },
          "dev.westron.contrast": [
            {
              "kind": "non-text",
              "on": [
                "color.background.canvas",
                "color.background.surface",
                "color.background.sunken",
                "color.background.hover",
                "color.background.selected"
              ]
            }
          ]
        }
      }
    },
    "border": {
      "default": {
        "$value": "{color.neutral.6}",
        "$description": "Separators and the outline of a card: decorative in standard themes, 3:1 in high contrast, where every raised surface gets one.",
        "$extensions": {
          "dev.westron.contrast": [
            {
              "kind": "separator",
              "on": ["color.background.canvas", "color.background.surface", "color.background.sunken"]
            }
          ]
        }
      },
      "strong": {
        "$value": "{color.neutral.8}",
        "$description": "The border of a control that must be seen: a field, a checkbox, a radio ring, a secondary button.",
        "$extensions": {
          "dev.westron.contrast": [
            {
              "kind": "non-text",
              "on": [
                "color.background.canvas",
                "color.background.surface",
                "color.background.sunken",
                "color.background.muted"
              ]
            }
          ]
        }
      },
      "focus": {
        "$value": "{color.blue.8}",
        "$description": "The focus ring, and the outline of a selected item in high contrast.",
        "$extensions": {
          "dev.westron.contrast": [
            {
              "kind": "non-text",
              "on": [
                "color.background.canvas",
                "color.background.surface",
                "color.background.sunken",
                "color.background.hover",
                "color.background.selected"
              ]
            }
          ]
        }
      }
    },
