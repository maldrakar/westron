        "$description": "The fill of the primary action: a floating \"+\", Done. The accent, the same in light and dark.",
        "$extensions": {
          "dev.westron.usage": {
            "use": ["primary action fill"],
            "avoid": "Large areas, or more than one filled control on a screen; text and borders in the accent use text.accent and border.accent."
          }
        }
      },
