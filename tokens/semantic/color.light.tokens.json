        "$value": {"colorSpace": "oklch", "components": [0.4933, 0.1861, 268.19], "alpha": 0.12, "hex": "#3653C9"},
        "$description": "Laid under something that just moved, fading out. Translucent."
      },
      "accent-subtle": {
        "$value": "{color.blue.939}",
        "$description": "A quiet accent fill: the slot a dragged item will drop into. Opaque."
      },
      "glass": {
        "$value": {"colorSpace": "oklch", "components": [1, 0, "none"], "alpha": 0.72, "hex": "#FFFFFF"},
        "$description": "The face of a floating control where the system has no glass of its own (before OS 26). Translucent; the platform blurs what is under it.",
        "$extensions": {
          "dev.westron.usage": {
            "use": ["floating control before OS 26"],
            "avoid": "The content layer; on OS 26 and later use the system's glass."
          }
        }
      },
      "accent": {
        "$value": "{color.blue.493}",
