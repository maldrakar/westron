{
  "typography": {
    "$type": "typography",
    "$description": "Text roles. Headings are Onest, body text and controls the system font, code Geist Mono. On Apple each role follows its text style, so it scales with Dynamic Type (decisions/0011, 0013).",
    "heading": {
      "large": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontSize": {"value": 34, "unit": "px"},
          "fontWeight": "{font.weight.bold}",
          "letterSpacing": {"value": -0.34, "unit": "px"},
          "lineHeight": 1.206
        },
        "$description": "The title of a screen. Onest Bold at the size of the largeTitle text style, tracked in by 1 % of its size.",
        "$extensions": {"dev.westron.apple": {"textStyle": "largeTitle"}}
      },
      "medium": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontSize": {"value": 20, "unit": "px"},
          "fontWeight": "{font.weight.bold}",
          "letterSpacing": {"value": -0.2, "unit": "px"},
          "lineHeight": 1.25
        },
        "$description": "The title of a card, a section of a screen or an empty state. Onest Bold at the size of the title3 text style.",
        "$extensions": {"dev.westron.apple": {"textStyle": "title3"}}
      },
      "small": {
        "$value": {
          "fontFamily": "{font.family.heading}",
