          "letterSpacing": {"value": 0, "unit": "px"},
          "lineHeight": 1.385
        },
        "$description": "Code, logs, identifiers and hashes: Geist Mono at the size of the footnote text style.",
        "$extensions": {"dev.westron.apple": {"textStyle": "footnote"}}
