{
  "color": {
    "$type": "color",
    "background": {
      "canvas": {
        "$value": "{color.neutral.214}",
        "$description": "The ground of a screen and of the rows on it.",
        "$extensions": {
          "dev.westron.usage": {"use": ["screen background", "row background"], "avoid": "Cards and fields: use background.surface."}
        }
      },
      "surface": {
        "$value": "{color.neutral.253}",
        "$description": "Something raised off the canvas: a card, a field, a dragged item.",
        "$extensions": {
          "dev.westron.usage": {"use": ["card", "field", "dragged item"], "avoid": "The ground of a whole screen: use background.canvas."}
        }
      },
      "sidebar": {"$value": "{color.neutral.235}", "$description": "The sidebar column and its rows."},
      "muted": {
        "$value": "{color.neutral.291}",
        "$description": "A quiet fill inside content: chips, pills, columns, a highlighted row on a phone.",
        "$extensions": {
          "dev.westron.usage": {
            "use": ["chip", "pill", "column", "highlighted row"],
            "avoid": "The selected row in a sidebar: use background.selected."
          }
        }
      },
      "selected": {
        "$value": {"colorSpace": "oklch", "components": [0.3354, 0.02702, 273.2], "hex": "#323645"},
        "$description": "The selected row in a sidebar: the accent laid lightly over the sidebar, mixed opaque."
      },
      "hover": {
        "$value": {"colorSpace": "oklch", "components": [1, 0, "none"], "alpha": 0.05, "hex": "#FFFFFF"},
        "$description": "Laid over a control or row under the pointer. Translucent.",
        "$extensions": {"dev.westron.usage": {"use": ["pointer hover"], "avoid": "Selection: use background.selected."}}
      },
      "pressed": {
        "$value": {"colorSpace": "oklch", "components": [1, 0, "none"], "alpha": 0.09, "hex": "#FFFFFF"},
        "$description": "Laid over a control while it is pressed. Translucent."
      },
      "highlight": {
        "$value": {"colorSpace": "oklch", "components": [1, 0, "none"], "alpha": 0.08, "hex": "#FFFFFF"},
        "$description": "Laid under something that just moved, fading out. Translucent."
      },
      "accent-subtle": {
        "$value": {"colorSpace": "oklch", "components": [0.281, 0.05053, 273.23], "hex": "#212742"},
        "$description": "A quiet accent fill: the slot a dragged item will drop into. Opaque."
      },
