{
  "dimension": {
    "$type": "dimension",
    "text": {
      "body": { "$value": { "value": 16, "unit": "px" } }
    },
    "tracking": {
      "none": { "$value": { "value": 0, "unit": "px" } }
    },
    "elevation": {
      "1": { "$value": { "value": 2, "unit": "px" } }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 }
    },
    "leading": {
      "body": { "$type": "number", "$value": 1.5 }
    }
  },
  "palette": {
    "$type": "color",
    "black": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.25 } },
    "ink": { "$value": "{palette.black}" }
  },
  "color": {
    "shadow": {
      "$description": "No $type: an alias takes the type of the token it refers to",
      "$value": "{palette.ink}"
    }
  },
  "typography": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{dimension.text.body}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "{dimension.tracking.none}",
        "lineHeight": "{font.leading.body}"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "base": {
      "$value": {
        "color": "{color.shadow}",
        "offsetX": "{dimension.tracking.none}",
        "offsetY": "{dimension.elevation.1}",
        "blur": { "value": 4, "unit": "px" },
        "spread": "{dimension.tracking.none}"
      }
    },
    "stack": {
      "$value": [
        "{shadow.base}",
        {
          "color": "{palette.black}",
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 8, "unit": "px" },
          "blur": { "value": 16, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      ]
    },
    "card": { "$value": "{shadow.stack}" }
  }
}
