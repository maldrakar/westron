{
  "palette": {
    "$type": "color",
    "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1] } },
    "gray": { "$value": { "colorSpace": "srgb", "components": [0.5, 0.5, 0.5] } },
    "black": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0] } }
  },
  "space": {
    "$type": "dimension",
    "s": { "$value": { "value": 4, "unit": "px" } },
    "m": { "$value": { "value": 8, "unit": "px" } }
  }
}
